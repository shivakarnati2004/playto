# ──────────────────────────────────────────────────────────
# Playto KYC — Root Environment Variables
# Copy this file to .env and fill in real values
# Used by docker-compose.yml
# ──────────────────────────────────────────────────────────

# Django
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Database (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=playto

# CORS — comma-separated origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# SMTP (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
